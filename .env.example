# MongoDB Atlas connection string (server-side only — never prefix with NEXT_PUBLIC_)
MONGODB_URI=

# Secret used to sign admin session JWTs. Use a long random string.
JWT_SECRET=

# Cloudinary (server-side credentials; only the cloud name is safe to expose)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=manisha-readymades

# Public storefront configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CONTACT_PHONE=+91 99999 99999
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/qi73ryV5qYRawWdJ8?g_st=ac
